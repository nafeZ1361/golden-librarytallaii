# Trading safety defaults
TRADING_MODE=PAPER
ENABLE_LIVE_TRADING=NO
MT5_MAGIC_NUMBER=26080901

# Logging
LOG_DIR=logs

# Telegram error alerts (disabled by default)
TELEGRAM_ALERTS_ENABLED=NO
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_TIMEOUT=10

# Risk caps
RISK_MAX_VOLUME=1.0
RISK_MAX_DAILY_LOSS=0
RISK_MAX_SPREAD=0
RISK_MAX_OPEN_POSITIONS=0

# Staged volume control: hard cap, never exceeded automatically
MAX_VOLUME_TARGET=0.01
MIN_OBSERVATION_DAYS=3
VOLUME_STATE_PATH=volume_state.json
VOLUME_CHANGE_LOG=logs/volume_changes.log

RISK_MAX_DRAWDOWN_PCT=20.0
